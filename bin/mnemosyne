#!/usr/bin/env bash
# mnemosyne — start the memory god service, or run a CLI subcommand.
# Usage: bin/mnemosyne                         # start service (foreground)
#        PORT=8477 bin/mnemosyne
#        bin/mnemosyne reindex <scope> [--dir <path>] [--url <base-url>]
#        bin/mnemosyne ingest --file <path> [--scope <scope>] [--tag <tag>] [--url <base-url>]
#        bin/mnemosyne crawl <url> [--scope <scope>] [--tag <tag>] [--max-pages <n>] [--url-api <base-url>]
#        bin/mnemosyne persona sync --repo <path> --tier <tier> --scope-id <id> [--dry-run]
#        bin/mnemosyne persona seed [--root <path>] [--scope-id <id>]
#        bin/mnemosyne persona show <tier> <scope-id>
#        bin/mnemosyne agent init   [--harness claude|codex]
#        bin/mnemosyne agent status [--harness claude|codex]
set -euo pipefail
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"

# Resolve $0 through any symlink chain before computing HERE -- required
# since aha-03 (mnemosyne-agent-harness-install) links this script onto PATH
# as a symlink (e.g. ~/.local/bin/mnemosyne -> <clone>/bin/mnemosyne,
# matching this operator's own machine convention for codex/graphify/etc).
# `dirname "$0"` alone resolves relative to the SYMLINK's own directory
# (e.g. ~/.local/bin), not the real script's directory, which silently
# pointed every subcommand at the wrong repo root and broke with
# MODULE_NOT_FOUND -- caught for real running `mnemosyne agent status`
# through a fresh ~/.local/bin/mnemosyne symlink while testing aha-03's
# install script. Portable manual symlink-resolution loop (works without
# GNU-only `readlink -f`, which isn't guaranteed on every platform).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
HERE="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if [ "${1:-}" = "reindex" ]; then
  shift
  exec node "$HERE/bin/mnemosyne-reindex.mjs" "$@"
fi

if [ "${1:-}" = "ingest" ]; then
  shift
  # Plain node, like reindex.mjs (not tsx like persona.mjs) -- ingest.mjs is
  # a thin HTTP client (POST /ingest against lib/mnemosyne/server.ts's
  # MnemosyneClient HTTP API, default :3141), never importing lib/mnemosyne/
  # ingest/ingestDocument.ts directly.
  exec node "$HERE/bin/mnemosyne-ingest.mjs" "$@"
fi

if [ "${1:-}" = "crawl" ]; then
  shift
  # ro-11-bounded-website-crawl: same shape as `ingest` above -- plain node,
  # a thin HTTP client (POST /crawl against the same MnemosyneClient HTTP
  # API, :3141), never importing lib/mnemosyne/ingest/crawlAndIngest.ts
  # directly (the SSRF guard/robots.txt/fetch logic lives only in that
  # module and the server route that wraps it, never duplicated here).
  exec node "$HERE/bin/mnemosyne-crawl.mjs" "$@"
fi

if [ "${1:-}" = "persona" ]; then
  shift
  # Unlike reindex.mjs (plain HTTP client, no TS import), mnemosyne-persona.mjs
  # imports lib/mnemosyne/layer1/*.ts directly (pf-04) -- launched via tsx,
  # not plain node, since noEmit:true means there is no build step to import
  # a .ts module without it (see bin/mnemosyne-persona.mjs's own doc comment).
  exec node "$HERE/node_modules/.bin/tsx" "$HERE/bin/mnemosyne-persona.mjs" "$@"
fi

if [ "${1:-}" = "agent" ]; then
  shift
  # ro-03-agent-init-build-flag (epic: mnemosyne-repo-onboarding): agent.mjs's
  # new `--build` flag imports lib/mnemosyne/onboarding/onboardRepo.ts
  # directly, so this is now tsx-launched like persona.mjs (not plain node
  # like reindex.mjs) -- noEmit:true means there is no build step to import
  # a .ts module any other way. (Previously plain node: agent.mjs imported no
  # lib/mnemosyne/*.ts modules, only node:child_process/fs/os.)
  exec node "$HERE/node_modules/.bin/tsx" "$HERE/bin/mnemosyne-agent.mjs" "$@"
fi

# --version/--help must be handled BEFORE the catch-all server exec below --
# any unrecognized first arg otherwise silently starts the live HTTP server
# and blocks, which is exactly what a first-time user typing `mnemosyne
# --version` would hit (caught for real running the published install.sh
# end to end during the OSS release-readiness review).
if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ] || [ "${1:-}" = "version" ]; then
  node -e "console.log('mnemosyne v' + require('$HERE/package.json').version)"
  exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "help" ]; then
  sed -n '2,10p' "$HERE/bin/mnemosyne" | sed 's/^# \{0,1\}//'
  exit 0
fi

exec node "$HERE/src/server.mjs"
