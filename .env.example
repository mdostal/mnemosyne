# Mnemosyne service configuration (all optional — sensible defaults).
# Port to listen on (avoid 8726/8722/4870/8090/3002/3010/3021/5173/8446-8449).
PORT=8477
# Path to the swarm-memory CLI (defaults to `swarm-memory` on PATH).
SWARM_MEMORY_BIN=swarm-memory
# Where `remember` writes note files before indexing (append-only).
MNEMOSYNE_NOTES_DIR=$HOME/.local/share/mnemosyne/notes
# Per-CLI-call timeout in ms.
MNEMOSYNE_CLI_TIMEOUT_MS=90000
