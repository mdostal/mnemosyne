# Mnemosyne service configuration (all optional — sensible defaults).
# Port to listen on (avoid 8726/8722/4870/8090/3002/3010/3021/5173/8446-8449).
PORT=8477
# Interface to bind. Default 127.0.0.1 (this machine only). Set 0.0.0.0 only
# with MNEMOSYNE_API_TOKEN, e.g. in a container other containers reach by name.
MNEMOSYNE_HOST=127.0.0.1
# Bearer token every route except GET /health, /healthz and /ui needs. Keep it
# in the local vault and hand it over as this var or as MNEMOSYNE_API_TOKEN_FILE.
# Unset: only loopback callers are served.
MNEMOSYNE_API_TOKEN=
MNEMOSYNE_API_TOKEN_FILE=
# Path to the swarm-memory CLI (defaults to `swarm-memory` on PATH).
SWARM_MEMORY_BIN=swarm-memory
# Where `remember` writes note files before indexing (append-only).
MNEMOSYNE_NOTES_DIR=$HOME/.local/share/mnemosyne/notes
# Per-CLI-call timeout in ms.
MNEMOSYNE_CLI_TIMEOUT_MS=90000
# Bearer token every write route needs (POST /remember, /ingest, /lanes,
# /collections, /index, /reindex, /events/repo-merged). Unset: writes from
# loopback only. Never give it to agent runtimes.
MNEMOSYNE_ADMIN_TOKEN=
# 1 keeps plain POST /remember open without the token (agent write-back hooks).
MNEMOSYNE_OPEN_REMEMBER=
